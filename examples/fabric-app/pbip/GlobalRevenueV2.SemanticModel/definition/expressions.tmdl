/// The folder the CSV files are read from, as a path under https://raw.githubusercontent.com ending in '/' (owner/repository/branch/folder/). Every table reads https://raw.githubusercontent.com/<DataPath><file>.csv.
expression DataPath = "codexguy/bicharts/main/examples/fabric-app/data/" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 3d16c70d-12a3-5df3-99bc-a38db3b45a22

	annotation PBI_ResultType = Text

/// Loads one CSV file from the DataPath folder on raw.githubusercontent.com and promotes its header row.
expression fnLoadCsv =
		(fileName as text) as table =>
		let
		    // The host is a literal on purpose: the Power BI service refuses to refresh a web source whose base URL is
		    // computed (DynamicDataSourcesIsNotSupportedForRefresh). Only the path under it comes from the DataPath parameter.
		    Bytes = Web.Contents("https://raw.githubusercontent.com", [RelativePath = DataPath & fileName]),
		    Csv = Csv.Document(Bytes, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    Promoted = Table.PromoteHeaders(Csv, [PromoteAllScalars = true])
		in
		    Promoted
	lineageTag: 62ec4481-2ba0-5f88-be2e-38123e9d602f

	annotation PBI_ResultType = Function
