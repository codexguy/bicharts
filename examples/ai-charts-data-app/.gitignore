# Logs
logs
*.log
npm-debug.log*

# Dependencies
node_modules

# Build output
dist

# Generated by `rayfin env --framework vite` from rayfin/.env
.env.local

# Semantic model schema cache, rebuilt on demand
.schema/

# Short-lived Rayfin connector payload and result files (@microsoft/fabric-app-semantic-model-tools)
.fabric-app-semantic-model-tools-*

# Rayfin local, secret-bearing, and generated files (matches the Rayfin CLI's canonical .gitignore).
# Connector results over 8 KB spill into rayfin/.temp/invoke-results and contain model data.
*.local
rayfin/.env*
rayfin/.env.secrets
rayfin/.deployments.json
rayfin/.*.tmp
rayfin/.temp/
rayfin.config.json

# Added by Rayfin CLI
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist-ssr
*.tsbuildinfo
.vite
coverage
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Chart data saved by the RegiaBI chart server's query_semantic_model
.bic/

# Failure screenshots from the widget suite, and the render check's output
src/**/__screenshots__/
check-render-output/
# Refreshed widget code the private exporter writes, waiting for npm run widgets:refresh -- --apply
widgets-incoming/
.vitest-attachments/
